<Project>
    <Import Project="$([MSBuild]::GetPathOfFileAbove('Directory.Build.props', '$(MSBuildThisFileDirectory)..\'))" />
    <ItemGroup>
        <!-- MTP runner (xunit.v3 + global.json test.runner): VSTest collectors
             are ignored there; coverage comes from the MTP extension -->
        <PackageReference Include="Microsoft.Testing.Extensions.CodeCoverage">
            <PrivateAssets>all</PrivateAssets>
        </PackageReference>
        <PackageReference Include="Moq" />
        <PackageReference Include="xunit.v3" />
        <ProjectReference Include="$(MSBuildThisFileDirectory)..\tools\analyzers\Kaleido.Analyzers.Testing\Kaleido.Analyzers.Testing.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" PrivateAssets="all" />
        <!-- KAL1003 finds a SUT's file among these paths: src/ is referenced as compiled assemblies,
             so the compilation has no syntax for it (#405). Only the paths are used, never the text. -->
        <AdditionalFiles Include="$(MSBuildThisFileDirectory)..\src\**\*.cs" Exclude="$(MSBuildThisFileDirectory)..\src\**\bin\**;$(MSBuildThisFileDirectory)..\src\**\obj\**" Visible="false" />
    </ItemGroup>
    <PropertyGroup>
        <IsPackable>false</IsPackable>
        <!-- xUnit v3 test projects are self-executing (Microsoft.Testing.Platform) -->
        <OutputType>Exe</OutputType>
        <!-- xUnit1000 kept enabled: internal test classes are NOT discovered by
             the runner — fixtures must stay public even when the SUT is internal -->
        <NoWarn>1591</NoWarn>
        <!-- #406: a warning in a test project fails the build, as in src/; IDE rules (unused usings,
             naming...) run in the build too. -->
        <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
        <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
        <!-- Needed for IDE0005 (unused usings) in the build (dotnet/roslyn#41640); CS1591 stays off. -->
        <GenerateDocumentationFile>true</GenerateDocumentationFile>
    </PropertyGroup>
    <ItemGroup>
        <Using Include="Xunit" />
        <Using Include="Kaleido" />
        <Using Include="Moq" />
    </ItemGroup>
</Project>
