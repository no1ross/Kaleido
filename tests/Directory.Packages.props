<Project>
    <Import Project="$(MSBuildThisFileDirectory)..\Directory.Packages.props" />
    <ItemGroup>
        <PackageVersion Include="Microsoft.Testing.Extensions.CodeCoverage" Version="18.12.0" />
        <PackageVersion Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="8.0.34" />
    <PackageVersion Include="Microsoft.AspNetCore.Mvc.Testing" Version="8.0.34" />
        <PackageVersion Include="Microsoft.AspNetCore.TestHost" Version="8.0.34" />
        <PackageVersion Include="Microsoft.Data.Sqlite" Version="8.0.34" />
        <PackageVersion Include="Microsoft.EntityFrameworkCore.InMemory" Version="8.0.34" />
        <PackageVersion Include="Microsoft.Extensions.Configuration" Version="8.0.0" />
        <!-- FakeTimeProvider (#460): the 8.10.0 line of dotnet/extensions, as Compliance and Http.Resilience -->
        <PackageVersion Include="Microsoft.Extensions.TimeProvider.Testing" Version="8.10.0" />
        <PackageVersion Include="Moq" Version="4.18.4" />
        <PackageVersion Include="NetArchTest.Rules" Version="1.3.2" />
        <PackageVersion Include="xunit.v3" Version="4.0.3" />
        <!-- Analyzer testing packages (Kaleido.Analyzers.UnitTests) -->
        <!-- Reference-assembly test packages require Roslyn >= 4.11.0; only the test Workspaces
             versions move, while shipped analyzer projects retain their 4.8.0 minimum compiler. -->
        <PackageVersion Include="Basic.Reference.Assemblies" Version="1.8.15" />
        <PackageVersion Include="Basic.Reference.Assemblies.Net80" Version="1.8.15" />
        <PackageVersion Include="Microsoft.CodeAnalysis.CSharp.Workspaces" Version="4.11.0" />
        <PackageVersion Include="Microsoft.CodeAnalysis.Workspaces.Common" Version="4.11.0" />
    </ItemGroup>
</Project>
