<Project>
    <Import Project="$(MSBuildThisFileDirectory)..\Directory.Packages.props" />
    <ItemGroup>
        <PackageVersion Include="Microsoft.Testing.Extensions.CodeCoverage" Version="18.11.2" />
        <PackageVersion Include="Microsoft.AspNetCore.Mvc.Testing" Version="8.0.31" />
        <PackageVersion Include="Microsoft.AspNetCore.TestHost" Version="8.0.31" />
        <PackageVersion Include="Microsoft.Data.Sqlite" Version="8.0.31" />
        <PackageVersion Include="Microsoft.EntityFrameworkCore.InMemory" Version="8.0.31" />
        <PackageVersion Include="Microsoft.Extensions.Configuration" Version="8.0.0" />
        <PackageVersion Include="Moq" Version="4.18.4" />
        <PackageVersion Include="NetArchTest.Rules" Version="1.3.2" />
        <PackageVersion Include="xunit.v3" Version="4.0.1" />
        <!-- Analyzer testing packages (Kaleido.Analyzers.UnitTests) -->
        <!-- 1.6.0 is the latest line requiring only Microsoft.CodeAnalysis >= 3.9.0;
             newer lines force CodeAnalysis >= 4.9.2 and conflict with the tools/ 4.8.0 pin -->
        <PackageVersion Include="Basic.Reference.Assemblies" Version="1.6.0" />
        <PackageVersion Include="Basic.Reference.Assemblies.Net80" Version="1.6.0" />
        <PackageVersion Include="Microsoft.CodeAnalysis.CSharp.Workspaces" Version="4.8.0" />
        <PackageVersion Include="Microsoft.CodeAnalysis.Workspaces.Common" Version="4.8.0" />
    </ItemGroup>
</Project>
