; EditorConfig to support per-solution formatting.
; Use the EditorConfig VS add-in to make this work.
; http://editorconfig.org/
;
; Here are some resources for what's supported for .NET/C#
; https://kent-boogaart.com/blog/editorconfig-reference-for-c-developers
; https://learn.microsoft.com/visualstudio/ide/editorconfig-code-style-settings-reference
;
; Be **careful** editing this because some of the rules don't support adding a severity level.
; For instance if you change to `dotnet_sort_system_directives_first = true:warning` (adding `:warning`)
; then the rule will be silently ignored.

root = true

; ════════════════════════════════════════════════════════════════════════════
; Universal whitespace / encoding
; ════════════════════════════════════════════════════════════════════════════

[*]
indent_style = space
charset = utf-8
trim_trailing_whitespace = true
insert_final_newline = true

[*.resx]
trim_trailing_whitespace = false

[*.{xml,config,*proj,nuspec,props,resx,targets,yml,tasks}]
indent_size = 2

[*.{props,targets,ruleset,config,nuspec,resx,vsixmanifest,vsct}]
indent_size = 2

[*.json]
indent_size = 2

[*.{ps1,psm1}]
indent_size = 4

[*.sh]
indent_size = 4
end_of_line = lf

[*.{razor,cshtml}]
charset = utf-8-bom

; Verify snapshot files
[*.{received,verified}.{txt,xml,json}]
charset = utf-8-bom
end_of_line = lf
indent_size = unset
indent_style = unset
insert_final_newline = false
tab_width = unset
trim_trailing_whitespace = false

; ════════════════════════════════════════════════════════════════════════════
; C# style — applies to all *.cs files everywhere
; ════════════════════════════════════════════════════════════════════════════

[*.cs]
indent_size = 4

; Qualifier / predefined types
dotnet_sort_system_directives_first = true
dotnet_style_qualification_for_field = false:suggestion
dotnet_style_qualification_for_property = false:suggestion
dotnet_style_predefined_type_for_locals_parameters_members = true:suggestion
dotnet_style_predefined_type_for_member_access = true:suggestion

; var usage
csharp_style_var_for_built_in_types = true:suggestion
csharp_style_var_when_type_is_apparent = true:suggestion
csharp_style_var_elsewhere = true:suggestion

; Expression / statement style
csharp_style_throw_expression = false:suggestion
csharp_prefer_braces = true

; Newlines
csharp_new_line_before_open_brace = all
csharp_new_line_before_else = true
csharp_new_line_before_catch = true
csharp_new_line_before_finally = true
csharp_new_line_before_members_in_object_initializers = true
csharp_new_line_before_members_in_anonymous_types = true

; Namespace / modifier style
csharp_style_namespace_declarations = file_scoped
csharp_preferred_modifier_order = public,private,protected,internal,static,extern,new,virtual,abstract,sealed,override,readonly,unsafe,volatile,async:suggestion

; Naming conventions
; — const fields: PascalCase
dotnet_naming_rule.constant_fields_should_be_pascal_case.severity = suggestion
dotnet_naming_rule.constant_fields_should_be_pascal_case.symbols  = constant_fields
dotnet_naming_rule.constant_fields_should_be_pascal_case.style    = pascal_case_style
dotnet_naming_symbols.constant_fields.applicable_kinds   = field
dotnet_naming_symbols.constant_fields.required_modifiers = const
dotnet_naming_style.pascal_case_style.capitalization = pascal_case
; — private/internal fields: _camelCase
dotnet_naming_rule.camel_case_for_private_internal_fields.severity = suggestion
dotnet_naming_rule.camel_case_for_private_internal_fields.symbols  = private_internal_fields
dotnet_naming_rule.camel_case_for_private_internal_fields.style    = camel_case_underscore_style
dotnet_naming_symbols.private_internal_fields.applicable_kinds = field
dotnet_naming_symbols.private_internal_fields.applicable_accessibilities = private, internal
dotnet_naming_style.camel_case_underscore_style.required_prefix = _
dotnet_naming_style.camel_case_underscore_style.capitalization = camel_case

; ════════════════════════════════════════════════════════════════════════════
; Diagnostic rules — all *.{cs,vb} (global baseline)
; Scoped overrides appear in the per-glob sections below.
; ════════════════════════════════════════════════════════════════════════════

[*.{cs,vb}]

; ── Roslyn / IDE ─────────────────────────────────────────────────────────────
dotnet_diagnostic.IDE0005.severity = warning   ; Remove unnecessary usings
dotnet_diagnostic.IDE0011.severity = warning   ; Curly braces around blocks
dotnet_diagnostic.IDE0020.severity = warning   ; Pattern matching (is + cast, with variable)
dotnet_diagnostic.IDE0029.severity = warning   ; Coalesce expression (non-nullable)
dotnet_diagnostic.IDE0030.severity = warning   ; Coalesce expression (nullable)
dotnet_diagnostic.IDE0031.severity = warning   ; Null propagation
dotnet_diagnostic.IDE0035.severity = warning   ; Remove unreachable code
dotnet_diagnostic.IDE0036.severity = warning   ; Order modifiers
dotnet_diagnostic.IDE0038.severity = warning   ; Pattern matching (is + cast, no variable)
dotnet_diagnostic.IDE0043.severity = warning   ; Invalid format string placeholder
dotnet_diagnostic.IDE0044.severity = warning   ; Make field readonly
dotnet_diagnostic.IDE0051.severity = warning   ; Remove unused private members
dotnet_diagnostic.IDE0055.severity = suggestion ; All formatting rules
dotnet_diagnostic.IDE0059.severity = warning   ; Unnecessary assignment
dotnet_diagnostic.IDE0060.severity = warning   ; Remove unused parameter
dotnet_code_quality_unused_parameters = non_public
dotnet_diagnostic.IDE0062.severity = warning   ; Make local function static
dotnet_diagnostic.IDE0130.severity = warning   ; Namespace must match folder structure
dotnet_diagnostic.IDE0161.severity = error     ; Convert to file-scoped namespace
dotnet_diagnostic.IDE0200.severity = warning   ; Lambda expression can be removed
dotnet_diagnostic.IDE0290.severity = warning   ; Use primary constructor
dotnet_diagnostic.IDE2000.severity = warning   ; Disallow multiple blank lines
dotnet_style_allow_multiple_blank_lines_experimental = false

; ── .NET / CA: naming & design ───────────────────────────────────────────────
dotnet_diagnostic.CA1018.severity = warning   ; Mark attributes with AttributeUsageAttribute
dotnet_diagnostic.CA1047.severity = warning   ; Do not declare protected member in sealed type
dotnet_diagnostic.CA1305.severity = warning   ; Specify IFormatProvider
dotnet_diagnostic.CA1507.severity = warning   ; Use nameof to express symbol names
dotnet_diagnostic.CA1510.severity = warning   ; Use ArgumentNullException throw helper
dotnet_diagnostic.CA1511.severity = warning   ; Use ArgumentException throw helper
dotnet_diagnostic.CA1512.severity = warning   ; Use ArgumentOutOfRangeException throw helper
dotnet_diagnostic.CA1513.severity = warning   ; Use ObjectDisposedException throw helper
dotnet_diagnostic.CA1725.severity = suggestion ; Parameter names should match base declaration
dotnet_diagnostic.CA1802.severity = warning   ; Use literals where appropriate
dotnet_diagnostic.CA1805.severity = warning   ; Do not initialize unnecessarily
dotnet_diagnostic.CA1810.severity = warning   ; Do not initialize unnecessarily (static ctor)
dotnet_diagnostic.CA1821.severity = warning   ; Remove empty finalizers
dotnet_diagnostic.CA1822.severity = warning   ; Make member static
dotnet_code_quality.CA1822.api_surface = private, internal
dotnet_diagnostic.CA1823.severity = warning   ; Avoid unused private fields
dotnet_diagnostic.CA1825.severity = warning   ; Avoid zero-length array allocations
dotnet_diagnostic.CA1826.severity = suggestion ; Don't use Enumerable on indexable collections
dotnet_diagnostic.CA1827.severity = warning   ; Don't use Count() when Any() works
dotnet_diagnostic.CA1828.severity = warning   ; Don't use CountAsync() when AnyAsync() works
dotnet_diagnostic.CA1829.severity = warning   ; Use Length/Count instead of Count()
dotnet_diagnostic.CA1830.severity = warning   ; Prefer typed Append/Insert on StringBuilder
dotnet_diagnostic.CA1831.severity = warning   ; Use AsSpan/AsMemory over Range indexers
dotnet_diagnostic.CA1832.severity = warning   ; Use AsSpan/AsMemory over Range indexers
dotnet_diagnostic.CA1833.severity = warning   ; Use AsSpan/AsMemory over Range indexers
dotnet_diagnostic.CA1834.severity = warning   ; Use StringBuilder.Append(char) where applicable
dotnet_diagnostic.CA1835.severity = warning   ; Prefer Memory-based ReadAsync/WriteAsync
dotnet_diagnostic.CA1836.severity = warning   ; Prefer IsEmpty over Count
dotnet_diagnostic.CA1837.severity = warning   ; Use Environment.ProcessId
dotnet_diagnostic.CA1838.severity = warning   ; Avoid StringBuilder P/Invoke params
dotnet_diagnostic.CA1839.severity = warning   ; Use Environment.ProcessPath
dotnet_diagnostic.CA1840.severity = warning   ; Use Environment.CurrentManagedThreadId
dotnet_diagnostic.CA1841.severity = warning   ; Prefer Dictionary.Contains methods
dotnet_diagnostic.CA1842.severity = warning   ; Don't use WhenAll with a single task
dotnet_diagnostic.CA1843.severity = warning   ; Don't use WaitAll with a single task
dotnet_diagnostic.CA1844.severity = warning   ; Provide memory-based overrides on Stream
dotnet_diagnostic.CA1845.severity = warning   ; Use span-based string.Concat
dotnet_diagnostic.CA1846.severity = warning   ; Prefer AsSpan over Substring
dotnet_diagnostic.CA1847.severity = warning   ; Use string.Contains(char) for single chars
dotnet_diagnostic.CA1848.severity = suggestion ; Use LoggerMessage delegates (perf opt-in)
dotnet_diagnostic.CA1852.severity = warning   ; Seal internal types
dotnet_diagnostic.CA1854.severity = warning   ; Prefer TryGetValue over ContainsKey+indexer
dotnet_diagnostic.CA1855.severity = warning   ; Prefer Clear over Fill
dotnet_diagnostic.CA1856.severity = error     ; Incorrect usage of ConstantExpected attribute
dotnet_diagnostic.CA1857.severity = warning   ; Constant expected for parameter
dotnet_diagnostic.CA1858.severity = warning   ; Use StartsWith instead of IndexOf
dotnet_diagnostic.CA1859.severity = suggestion ; Use concrete types for performance (micro-opt)
dotnet_diagnostic.CA1873.severity = suggestion ; Avoid allocations in guarded logging calls
dotnet_diagnostic.CA2007.severity = silent    ; ConfigureAwait — not applicable in ASP.NET Core
dotnet_diagnostic.CA2008.severity = warning   ; Do not create tasks without TaskScheduler
dotnet_diagnostic.CA2009.severity = warning   ; Don't call ToImmutableCollection on ImmutableCollection
dotnet_diagnostic.CA2011.severity = warning   ; Avoid infinite recursion
dotnet_diagnostic.CA2012.severity = warning   ; Use ValueTask correctly
dotnet_diagnostic.CA2013.severity = warning   ; Don't use ReferenceEquals with value types
dotnet_diagnostic.CA2014.severity = warning   ; Don't use stackalloc in loops
dotnet_diagnostic.CA2016.severity = warning   ; Forward CancellationToken to methods that take one
dotnet_diagnostic.CA2022.severity = warning   ; Avoid inexact read with Stream.Read
dotnet_diagnostic.CA2200.severity = warning   ; Rethrow to preserve stack details
dotnet_diagnostic.CA2201.severity = warning   ; Do not raise reserved exception types
dotnet_diagnostic.CA2208.severity = warning   ; Instantiate argument exceptions correctly
dotnet_diagnostic.CA2245.severity = warning   ; Do not assign a property to itself
dotnet_diagnostic.CA2246.severity = warning   ; Assigning symbol and its member in same statement
dotnet_diagnostic.CA2249.severity = warning   ; Use string.Contains instead of IndexOf
dotnet_diagnostic.CA2263.severity = warning   ; Prefer generic overload (non-generic exercises Type args)

; CA1000: static factory methods on generic result types are an intended API pattern
; (e.g. ProcessStepHandlerResult<T>.Success) — changing them would break the API
dotnet_diagnostic.CA1000.severity = suggestion

; SYSLIB1054: Use LibraryImportAttribute instead of DllImportAttribute
dotnet_diagnostic.SYSLIB1054.severity = warning

; ── Meziantou / Roslynator ───────────────────────────────────────────────────
dotnet_diagnostic.MA0002.severity = warning   ; Use IEqualityComparer/IComparer overload
dotnet_diagnostic.MA0004.severity = none      ; StringComparison — CA1862 covers the real cases
dotnet_diagnostic.MA0006.severity = warning   ; Use string.Equals for ordinal comparisons
dotnet_diagnostic.MA0016.severity = warning   ; Prefer collection abstraction over concrete type
dotnet_diagnostic.MA0037.severity = suggestion ; Remove empty statements
dotnet_diagnostic.MA0048.severity = suggestion ; File name must match type name (small-type files)
dotnet_diagnostic.MA0051.severity = suggestion ; Method is too long (known tech debt, not quick fix)

; RCS1194: Kaleido exceptions require a 'code' parameter by design — the BCL
; ctor triad would allow Code-less instances, breaking the hierarchy's invariant
dotnet_diagnostic.RCS1194.severity = none

; EF Core entity navigation properties use ICollection<T> by convention
[src/Kaleido.Provider.SQLite/**/*.cs]
dotnet_diagnostic.KAL0018.severity = none

; ════════════════════════════════════════════════════════════════════════════
; tests/ — all test projects
; ════════════════════════════════════════════════════════════════════════════

[tests/**/*.cs]

; Test doubles / fakes / stubs legitimately differ from production conventions:

; CA1707: Method_Scenario_Expected is the test naming convention
dotnet_diagnostic.CA1707.severity = silent

; CA1711: *Collection suffix is the xUnit collection-fixture convention
dotnet_diagnostic.CA1711.severity = silent

; CA1822: stub handlers must stay instance methods — resolved via BindingFlags.Instance
dotnet_diagnostic.CA1822.severity = silent

; CA2263: tests deliberately exercise non-generic overloads
dotnet_diagnostic.CA2263.severity = silent

; IDE0060: stub signatures must mirror the contract even when params are unused
dotnet_diagnostic.IDE0060.severity = silent

; KAL0002: test stubs legitimately throw BCL exceptions (Moq setups, failure injection)
dotnet_diagnostic.KAL0002.severity = none

; KAL0003: test code uses '!' for Assert.NotNull follow-ons and null! arg injection
dotnet_diagnostic.KAL0003.severity = none

; KAL0007: tests resolve services from IServiceProvider to verify DI registrations
dotnet_diagnostic.KAL0007.severity = none

; KAL0012: tests legitimately use new ServiceCollection() and new HttpClient() to build
;          test containers — this is the test composition root, not production DI
dotnet_diagnostic.KAL0012.severity = none

; KAL0019: xUnit async test methods do not take CancellationToken — that is the xUnit contract
dotnet_diagnostic.KAL0019.severity = none

; MA0002/MA0006/MA0016: collection abstractions and comparers matter less in
; assertions and test fakes — keep as suggestions
dotnet_diagnostic.MA0002.severity = suggestion
dotnet_diagnostic.MA0016.severity = suggestion

