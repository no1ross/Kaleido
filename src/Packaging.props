<Project>
    <!-- Package metadata shared by every shipped package: the src/ projects and the
         consumer analyzer (tools/analyzers/Kaleido.Analyzers). -->
    <PropertyGroup>
        <IsPackable>true</IsPackable>
        <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
        <PackageRequireLicenseAcceptance>false</PackageRequireLicenseAcceptance>
        <PackageReadmeFile>README.md</PackageReadmeFile>
        <PackageIcon>kaleido-nuget-icon-128.png</PackageIcon>
        <PackageProjectUrl>https://github.com/no1ross/Kaleido</PackageProjectUrl>
        <PublishRepositoryUrl>true</PublishRepositoryUrl>
        <EmbedUntrackedSources>true</EmbedUntrackedSources>
        <RepositoryType>git</RepositoryType>
        <Authors>Andrew Ross</Authors>
        <Company>Andrew Ross</Company>
        <Copyright>Copyright 2026 Andrew Ross</Copyright>
        <RepositoryUrl>https://github.com/no1ross/Kaleido</RepositoryUrl>
    </PropertyGroup>
    <ItemGroup>
        <PackageReference Include="Microsoft.SourceLink.GitHub" PrivateAssets="All" />
        <None Include="$(MSBuildProjectDirectory)\README.md" Pack="true" PackagePath="\" />
        <None Include="$(MSBuildThisFileDirectory)..\docs\assets\kaleido-nuget-icon-128.png" Pack="true" PackagePath="\" Visible="false" />
        <None Include="$(MSBuildThisFileDirectory)..\NOTICE" Pack="true" PackagePath="\" Visible="false" />
    </ItemGroup>
</Project>
