<Project>
    <!-- Package metadata shared by every shipped package: the src/ projects and the
         consumer analyzer (tools/analyzers/Kaleido.Analyzers). -->
    <PropertyGroup>
        <IsPackable>true</IsPackable>
        <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
        <PackageRequireLicenseAcceptance>false</PackageRequireLicenseAcceptance>
        <PackageReadmeFile>README.md</PackageReadmeFile>
        <PackageIcon>kaleido-nuget-icon-128.png</PackageIcon>
        <PackageProjectUrl>https://github.com/no1ross/Kaleido</PackageProjectUrl>
        <PublishRepositoryUrl>true</PublishRepositoryUrl>
        <EmbedUntrackedSources>true</EmbedUntrackedSources>
        <RepositoryType>git</RepositoryType>
        <Authors>Andrew Ross</Authors>
        <Company>Andrew Ross</Company>
        <Copyright>Copyright 2026 Andrew Ross</Copyright>
        <RepositoryUrl>https://github.com/no1ross/Kaleido</RepositoryUrl>
    </PropertyGroup>
    <ItemGroup>
        <PackageReference Include="Microsoft.SourceLink.GitHub" PrivateAssets="All" />
        <None Include="$(MSBuildProjectDirectory)\README.md" Pack="true" PackagePath="\" />
        <None Include="$(MSBuildThisFileDirectory)..\docs\assets\kaleido-nuget-icon-128.png" Pack="true" PackagePath="\" Visible="false" />
        <None Include="$(MSBuildThisFileDirectory)..\NOTICE" Pack="true" PackagePath="\" Visible="false" />
        <!-- Apache-2.0 section 4(a): a redistributed package carries the license text, not only the expression. -->
        <None Include="$(MSBuildThisFileDirectory)..\LICENSE" Pack="true" PackagePath="\" Visible="false" />
    </ItemGroup>

    <!-- #431: the packages share internal seams (InternalsVisibleTo), so they move together. Every
         dependency on a sibling package is packed as an exact range [x.y.z] instead of NuGet's
         default minimum (>=), so a mixed set fails at restore rather than at run time.
         Test-PackageConsumer.ps1 asserts the result, so an SDK change to this NuGet target fails CI. -->
    <Target Name="KaleidoExactSiblingVersions" AfterTargets="_GetProjectReferenceVersions">
        <ItemGroup>
            <_KaleidoExactProjectReferences Include="@(_ProjectReferencesWithVersions)">
                <ProjectVersion>[%(_ProjectReferencesWithVersions.ProjectVersion)]</ProjectVersion>
            </_KaleidoExactProjectReferences>
            <_ProjectReferencesWithVersions Remove="@(_ProjectReferencesWithVersions)" />
            <_ProjectReferencesWithVersions Include="@(_KaleidoExactProjectReferences)" />
        </ItemGroup>
    </Target>
</Project>
