<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<Description>Kaleido MCP adapter: publishes a Kaleido host&apos;s capabilities to AI agents as Model Context Protocol tools.</Description>
		<PackageTags>mcp;model-context-protocol;ai;agents;kaleido</PackageTags>
	</PropertyGroup>

	<ItemGroup>
		<FrameworkReference Include="Microsoft.AspNetCore.App" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="ModelContextProtocol.AspNetCore" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\..\Core\Kaleido\Kaleido.csproj" />
		<ProjectReference Include="..\..\Transports\Http\Kaleido.Http\Kaleido.Http.csproj" />
		<ProjectReference Include="..\..\Transports\Http\Kaleido.Http.Server\Kaleido.Http.Server.csproj" />
		<ProjectReference Include="..\..\Transports\Http\Kaleido.Http.Client\Kaleido.Http.Client.csproj" />
		<ProjectReference Include="..\..\Capabilities\Registry\Kaleido.Registry\Kaleido.Registry.csproj" />
		<ProjectReference Include="..\..\Capabilities\Registry\Kaleido.Registry.Client\Kaleido.Registry.Client.csproj" />
		<ProjectReference Include="..\..\Capabilities\Registry\Kaleido.Registry.Http.Client\Kaleido.Registry.Http.Client.csproj" />
		<ProjectReference Include="..\..\Capabilities\Process\Kaleido.Process\Kaleido.Process.csproj" />
		<ProjectReference Include="..\..\Capabilities\Process\Kaleido.Process.Client\Kaleido.Process.Client.csproj" />
		<ProjectReference Include="..\..\Capabilities\Process\Kaleido.Process.Http.Client\Kaleido.Process.Http.Client.csproj" />
		<ProjectReference Include="..\..\Capabilities\Queryable\Kaleido.Queryable\Kaleido.Queryable.csproj" />
		<ProjectReference Include="..\..\Capabilities\Queryable\Kaleido.Queryable.Client\Kaleido.Queryable.Client.csproj" />
		<ProjectReference Include="..\..\Capabilities\Queryable\Kaleido.Queryable.Http.Client\Kaleido.Queryable.Http.Client.csproj" />
	</ItemGroup>

	<ItemGroup>
		<Using Include="System.Diagnostics.CodeAnalysis" />
		<Using Include="Kaleido.Exceptions" />
		<Using Include="Kaleido.Http" />
		<Using Include="Kaleido.Http.Client.Calls" />
		<Using Include="Kaleido.Http.Client.Configuration" />
		<Using Include="Kaleido.Http.Client.Transport" />
		<Using Include="Kaleido.Http.Server.Observability" />
		<Using Include="Kaleido.Observability" />
		<Using Include="Kaleido.Process" />
		<Using Include="Kaleido.Process.Client" />
		<Using Include="Kaleido.Process.Execution" />
		<Using Include="Kaleido.Queryable" />
		<Using Include="Kaleido.Queryable.Client" />
		<Using Include="Kaleido.Queryable.Query" />
		<Using Include="Kaleido.Registry" />
		<Using Include="Kaleido.Registry.Client" />
	</ItemGroup>

	<ItemGroup>
		<!-- Default agent instructions: Markdown, overridable or extendable through Kaleido:Mcp. -->
		<EmbeddedResource Include="Instructions\DefaultInstructions.md" LogicalName="Kaleido.Mcp.Instructions.DefaultInstructions.md" />
		<!-- Appended when Kaleido:Mcp:ToolListing is FrontDoor: how unlisted tools are reached. -->
		<EmbeddedResource Include="Instructions\FrontDoorInstructions.md" LogicalName="Kaleido.Mcp.Instructions.FrontDoorInstructions.md" />
	</ItemGroup>
	<ItemGroup>
		<!-- Tests beyond this package's own unit tests (src/Directory.Build.props). -->
		<InternalsVisibleTo Include="Kaleido.Mcp.FunctionalTests" />
		<InternalsVisibleTo Include="Kaleido.Observability.OpenTelemetry.UnitTests" />
	</ItemGroup>
</Project>
