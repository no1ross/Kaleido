<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<Description>Kaleido core: bootstrap, metadata, eventing, correlation and the Process and Queryable runtimes. Steps, query sources and views are declared as types; no transport or ASP.NET Core dependency.</Description>
		<PackageTags>kaleido;process;workflow;query;metadata;runtime</PackageTags>
	</PropertyGroup>

<ItemGroup>
		<PackageReference Include="Microsoft.Extensions.Compliance.Abstractions" />
		<PackageReference Include="Microsoft.Extensions.Configuration.Abstractions" />
		<PackageReference Include="Microsoft.Extensions.Configuration.Binder" />
		<PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
		<PackageReference Include="Microsoft.Extensions.Diagnostics.HealthChecks" />
		<PackageReference Include="Microsoft.Extensions.Logging" />
		<PackageReference Include="Microsoft.Extensions.Hosting.Abstractions" />
		<PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
		<PackageReference Include="Polly.Core" />
	</ItemGroup>

	<!-- EXT-05: this reference exists only so Kaleido.nupkg declares a package
	     dependency on Kaleido.Analyzers, which flows the consumer rules to every
	     service that installs Kaleido. It is not an Analyzer item, so the rules do
	     not run on the framework (the consumer guide's examples load them as an Analyzer item).
	     Restore ignores ReferenceOutputAssembly=false references, so pack would drop the
	     dependency; instead IncludeAssets="analyzers" keeps the analyzer DLL out of the
	     compile and out of downstream projects, PrivateAssets="none" lets the analyzers
	     flow to consumers, and Private="false" keeps it out of bin. -->
	<ItemGroup>
		<ProjectReference
			Include="..\..\tools\analyzers\Kaleido.Analyzers\Kaleido.Analyzers.csproj"
			Private="false"
			IncludeAssets="analyzers"
			PrivateAssets="none" />
	</ItemGroup>

	<ItemGroup>
		<!-- The servers, clients and front doors are built into the solution: they use core's transport seams (authorization evaluation, correlation initialization) without making them public API; the outgoing clients and the MCP adapter read the inbound caller the server set (ADR 0022). -->
		<InternalsVisibleTo Include="Kaleido.Platform" />
		<InternalsVisibleTo Include="Kaleido.Server" />
		<InternalsVisibleTo Include="Kaleido.Client" />
		<InternalsVisibleTo Include="Kaleido.Http" />
		<InternalsVisibleTo Include="Kaleido.Http.Server" />
		<InternalsVisibleTo Include="Kaleido.Http.Client" />
		<InternalsVisibleTo Include="Kaleido.Mcp" />
		<InternalsVisibleTo Include="Kaleido.Registry" />
		<InternalsVisibleTo Include="Kaleido.Registry.Http" />
		<!-- The OpenTelemetry provider lays its configuration section over the options from code with core's overlay (ADR 0030). -->
		<InternalsVisibleTo Include="Kaleido.Observability.OpenTelemetry" />
		<!-- Tests beyond this package's own unit tests (src/Directory.Build.props). -->
		<InternalsVisibleTo Include="Kaleido.Platform.UnitTests" />
		<InternalsVisibleTo Include="Kaleido.Server.UnitTests" />
		<InternalsVisibleTo Include="Kaleido.Client.UnitTests" />
		<InternalsVisibleTo Include="Kaleido.Http.UnitTests" />
		<InternalsVisibleTo Include="Kaleido.Http.Server.UnitTests" />
		<InternalsVisibleTo Include="Kaleido.Http.Client.UnitTests" />
		<InternalsVisibleTo Include="Kaleido.Mcp.UnitTests" />
		<InternalsVisibleTo Include="Kaleido.Registry.UnitTests" />
		<InternalsVisibleTo Include="Kaleido.Registry.Http.UnitTests" />
		<InternalsVisibleTo Include="Kaleido.Http.FunctionalTests" />
		<InternalsVisibleTo Include="Kaleido.IntegrationTests" />
	</ItemGroup>
</Project>
