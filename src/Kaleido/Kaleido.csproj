<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<Description>Kaleido core: bootstrap, metadata, eventing, correlation and the Process and Queryable runtimes. Steps, query sources and views are declared as types; no transport or ASP.NET Core dependency.</Description>
		<PackageTags>kaleido;process;workflow;query;metadata;runtime</PackageTags>
	</PropertyGroup>

<ItemGroup>
		<PackageReference Include="Microsoft.Extensions.Compliance.Abstractions" />
		<PackageReference Include="Microsoft.Extensions.Configuration.Abstractions" />
		<PackageReference Include="Microsoft.Extensions.Configuration.Binder" />
		<PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
		<PackageReference Include="Microsoft.Extensions.Logging" />
		<PackageReference Include="Microsoft.Extensions.Hosting.Abstractions" />
		<PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
		<PackageReference Include="Polly.Core" />
	</ItemGroup>

	<!-- EXT-05: this reference exists only so Kaleido.nupkg declares a package
	     dependency on Kaleido.Analyzers, which flows the consumer rules to every
	     service that installs Kaleido. It is not an Analyzer item, so the rules do
	     not run on the framework (the samples load them in samples/Directory.Build.props).
	     Restore ignores ReferenceOutputAssembly=false references, so pack would drop the
	     dependency; instead IncludeAssets="analyzers" keeps the analyzer DLL out of the
	     compile and out of downstream projects, PrivateAssets="none" lets the analyzers
	     flow to consumers, and Private="false" keeps it out of bin. -->
	<ItemGroup>
		<ProjectReference
			Include="..\..\tools\analyzers\Kaleido.Analyzers\Kaleido.Analyzers.csproj"
			Private="false"
			IncludeAssets="analyzers"
			PrivateAssets="none" />
	</ItemGroup>

	<ItemGroup>
		<!-- Transports are built into the solution: the HTTP transport uses core's transport seams (authorization evaluation, correlation initialization) without making them public API; the outgoing clients and the MCP adapter read the inbound caller the transport set (ADR 0022). -->
		<InternalsVisibleTo Include="Kaleido.Http" />
		<InternalsVisibleTo Include="Kaleido.Http.Client" />
		<InternalsVisibleTo Include="Kaleido.Http.Mcp" />
		<!-- Tests beyond this package's own unit tests (src/Directory.Build.props). -->
		<InternalsVisibleTo Include="Kaleido.Http.UnitTests" />
		<InternalsVisibleTo Include="Kaleido.Http.FunctionalTests" />
		<InternalsVisibleTo Include="Kaleido.Http.Client.UnitTests" />
		<InternalsVisibleTo Include="Kaleido.Http.Mcp.UnitTests" />
		<InternalsVisibleTo Include="Kaleido.IntegrationTests" />
	</ItemGroup>
</Project>
