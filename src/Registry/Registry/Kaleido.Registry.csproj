<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<Description>Kaleido control registry: the central registry every Kaleido service registers with and heartbeats to, serving the merged registry of every service version and its instances&apos; status (#553).</Description>
		<PackageTags>kaleido;registry;discovery;aspnetcore</PackageTags>
	</PropertyGroup>

	<ItemGroup>
		<FrameworkReference Include="Microsoft.AspNetCore.App" />
	</ItemGroup>

	<ItemGroup>
		<!-- Until the per-service registry is removed (#581), the registry serves the shared snapshot of the HTTP server's in-host registry service; then it builds on Kaleido.Server. -->
		<ProjectReference Include="..\..\Http\Http.Server\Kaleido.Http.Server.csproj" />
	</ItemGroup>

	<ItemGroup>
		<!-- The registry's HTTP API maps the registry's internal seams. -->
		<InternalsVisibleTo Include="Kaleido.Registry.Http" />
		<!-- Tests beyond this package's own unit tests (src/Directory.Build.props). -->
		<InternalsVisibleTo Include="Kaleido.Registry.Http.UnitTests" />
		<InternalsVisibleTo Include="Kaleido.Http.FunctionalTests" />
		<InternalsVisibleTo Include="Kaleido.Provider.SQLite.UnitTests" />
	</ItemGroup>
</Project>
