<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<Description>Reference Kaleido stores on SQLite (process state, idempotent results, event outbox, the control registry). A worked example of the store contracts, not a production provider.</Description>
		<PackageTags>kaleido;sqlite;entity-framework-core;process-state</PackageTags>
	</PropertyGroup>

<ItemGroup>
		<PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
		<PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" />
	</ItemGroup>

	<ItemGroup>
		<Using Include="Kaleido.Processor" />
		<Using Include="Kaleido.Processor.Execution" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\..\Kaleido\Kaleido.csproj" />
		<!-- One provider per technology implements every Kaleido store it serves: the control registry's too (#553). -->
		<ProjectReference Include="..\..\Registry\Registry\Kaleido.Registry.csproj" />
	</ItemGroup>

	<ItemGroup>
		<!-- Tests beyond this package's own unit tests (src/Directory.Build.props). -->
		<InternalsVisibleTo Include="Kaleido.IntegrationTests" />
		<InternalsVisibleTo Include="Kaleido.Observability.OpenTelemetry.UnitTests" />
	</ItemGroup>
</Project>
