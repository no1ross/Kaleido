<Project Sdk="Microsoft.NET.Sdk">
<PropertyGroup>
		<Description>Kaleido HTTP wire contracts shared by the server (Kaleido.Http) and the clients (Kaleido.Http.Client): request and response types, JSON options and correlation header names.</Description>
		<PackageTags>kaleido;http;contracts</PackageTags>
		<RootNamespace>Kaleido.Http</RootNamespace>
	</PropertyGroup>
	<ItemGroup>
		<ProjectReference Include="..\Kaleido\Kaleido.csproj" />
	</ItemGroup>

	<ItemGroup>
		<!-- IDistributedCache only, for AddDistributedRegistrySnapshots(): the host picks the backend (#275). -->
		<PackageReference Include="Microsoft.Extensions.Caching.Abstractions" />
	</ItemGroup>

	<ItemGroup>
		<!-- The server and the clients share internal route and mapping infrastructure. -->
		<InternalsVisibleTo Include="Kaleido.Http" />
		<InternalsVisibleTo Include="Kaleido.Http.Client" />
		<!-- Tests beyond this package's own unit tests (src/Directory.Build.props). -->
		<InternalsVisibleTo Include="Kaleido.Http.UnitTests" />
		<InternalsVisibleTo Include="Kaleido.Http.FunctionalTests" />
		<InternalsVisibleTo Include="Kaleido.Http.Client.UnitTests" />
	</ItemGroup>
</Project>
