<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<Description>Typed HTTP clients for calling remote Kaleido services (registry, process state, step execution, queries), configured from Kaleido:Clients, with resilience and correlation propagation.</Description>
		<PackageTags>kaleido;http;client;httpclient</PackageTags>
	</PropertyGroup>

<ItemGroup>
		<PackageReference Include="Microsoft.Extensions.Configuration.Abstractions" />
		<PackageReference Include="Microsoft.Extensions.Configuration.Binder" />
		<PackageReference Include="Microsoft.Extensions.Diagnostics.HealthChecks" />
		<PackageReference Include="Microsoft.Extensions.Http" />
		<PackageReference Include="Microsoft.Extensions.Http.Resilience" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\Kaleido.Http.Abstractions\Kaleido.Http.Abstractions.csproj" />
	</ItemGroup>

	<ItemGroup>
		<InternalsVisibleTo Include="Kaleido.Http.Client.UnitTests" />
	</ItemGroup>

</Project>
