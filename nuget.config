<?xml version="1.0" encoding="utf-8"?>
<!-- Kaleido restores from nuget.org only: a developer's own feeds (e.g. the Kaleido preview feed the
     sample repositories use) never take part in this repository's restore. One source, all packages
     mapped to it (NU1507 under central package management). -->
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>
  <packageSourceMapping>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
  </packageSourceMapping>
</configuration>