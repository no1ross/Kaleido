{
  // Kaleido foundation settings only. Add each capability/transport's section when that owner is migrated.
  "Kaleido": {
    // Required: lowercase service identity, also used in published route names.
    "ServiceName": "orders",
    // Optional: opaque service version; required by an HTTP host that publishes versioned routes.
    "ServiceVersion": "1",
    // Optional: human-readable registry metadata.
    "DisplayName": "Orders",
    // Optional: normally omit InstanceId so Kaleido generates a fresh identifier per running instance.
    // If supplied, replace this example with a unique GUID for each instance.
    // "InstanceId": "76d86f5c-3328-4a26-a8a0-196fb7948dda",
    "Description": "Processes and queries orders"
  }
}

// Assemblies is required in the KaleidoServiceOptions passed in code to AddKaleido();
// TypeFilter is an optional Func<Type, bool> supplied in code. Neither can be bound from JSON.
